{% for rest in include.resource.rest %}
  {% for resource in rest.resource %}
    {% for ext in resource.extension %}
      {% if ext.url contains 'capabilitystatement-search-parameter-combination' %}
        <div style="margin: 10px 0; padding: 10px; border-left: 4px solid #0066cc; background: #f5f5f5;">
          <strong>Required Search Parameter Combination:</strong>
          <ul>
            {% for child_ext in ext.extension %}
              {% if child_ext.url == 'required' %}
                <li><strong>Required:</strong> <code>{{ child_ext.valueString }}</code></li>
              {% elsif child_ext.url == 'optional' %}
                <li><strong>Optional:</strong> <code>{{ child_ext.valueString }}</code></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}
  {% endfor %}
{% endfor %}
