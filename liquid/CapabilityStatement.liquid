{% include narrative-start.html %}
{% for rest in CapabilityStatement.rest %}
  {% assign patientResources = rest.resource | where: "type", "Patient" %}
  {% for resource in patientResources %}
    {% if resource.extension %}
      {% assign combinations = resource.extension | where: "url", "http://hl7.org/fhir/StructureDefinition/capabilitystatement-search-parameter-combination" %}
      {% for ext in combinations %}
<tr>
  {% include row-header.html header='Patient search parameter combination' %}
  <td class="content-container">
    <table>
      <thead>
        <tr>
          <td><em>Parameter</em></td>
          <td><em>Requirement</em></td>
          <td><em>Type</em></td>
        </tr>
      </thead>
      <tbody>
        {% assign requiredParams = ext.extension | where: "url", "required" %}
        {% for child_ext in requiredParams %}
        <tr>
          <td>{{ child_ext.valueString }}</td>
          <td><strong>Required</strong></td>
          <td>reference</td>
        </tr>
        {% endfor %}
        {% assign optionalParams = ext.extension | where: "url", "optional" %}
        {% for child_ext in optionalParams %}
        <tr>
          <td>{{ child_ext.valueString }}</td>
          <td>Optional</td>
          <td>reference</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </td>
</tr>
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% include version.html %}
{% include narrative-end.html %}
